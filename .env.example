# DeepSeek is the only LLM provider used by the application.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60

# Optional RAG configuration.
ENABLE_RAG=true
RAG_TOP_K=3
DOCUMENTS_DIR=documents

# Authentication and persistence.
APP_ENV=development
DATABASE_PATH=data/navpark.db
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_SESSION_DAYS=30
COOKIE_SECURE=false

# Use "console" locally. Production should use "webhook".
SMS_PROVIDER=console
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Optional public HTTPS origin for phone access, for example:
# MOBILE_BASE_URL=https://navpark.example.com
MOBILE_BASE_URL=
